---
import '@fontsource-variable/rethink-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Social preview image: a 1200x630 path from the site root, for example /og/home.jpg. */
  image?: string;
  /** What the preview image shows, for people who can't see it. */
  imageAlt?: string;
  /** Structured data (schema.org), written as one JSON-LD block. */
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title, description, image, imageAlt, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Proves to Google Search Console that this site is mine. -->
    <meta name="google-site-verification" content="g3saB0zEQ0mamDiML_FtmaVp0z9jriOV_jV4m0eP5jI" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nathan VanderByl" />
    <meta property="og:locale" content="en_GB" />
    {
      imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={imageUrl} />
          {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
        </>
      )
    }
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <!--
      Apply a saved theme choice before first paint so there is no flash.
      Without one the page is dark, whatever the OS prefers.
    -->
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light') {
          document.documentElement.dataset.theme = t;
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#ffffff');
        }
      } catch (e) {}
    </script>
    <!--
      Motion boot. Marks <html> so CSS can hide intro targets before first paint,
      and arms a recovery deadline first: if the motion bundle has not taken over
      in time, the mark flips to "recovered" and the page shows settled.
      Without JavaScript none of this runs and nothing is hidden.
      The deadline (ms) is the one motion value that cannot live in motion.ts.
    -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var DEADLINE = 1500;
        // Preview override for tuning: ?motion=reduced or ?motion=full beats the OS setting.
        var m = new URLSearchParams(location.search).get('motion');
        if (m === 'reduced' || m === 'full') d.dataset.motion = m;
        function arm() {
          window.__motionBootTimer = setTimeout(function () {
            if (d.dataset.motionBoot === 'pending') d.dataset.motionBoot = 'recovered';
          }, DEADLINE);
        }
        if (document.prerendering) {
          document.addEventListener('prerenderingchange', arm, { once: true });
        } else {
          arm();
        }
        d.dataset.motionBoot = 'pending';
      })();
    </script>
    <!-- Page-specific head content, after the motion boot so it can claim it (the Campaign Tower page). -->
    <slot name="head" />
  </head>
  <body data-motion-owner data-phase="initial">
    <!-- Page progress. Shown and driven by src/scripts/progress.ts; it duplicates the scrollbar, so hidden from assistive tech. -->
    <div class="progress" data-progress hidden aria-hidden="true"><div class="progress__bar" data-progress-bar></div></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
