---
// WorldBar's landing page, served at njvan.net/worldbar/.
// An app-specific page: it may use gradients, glows and shadows (the homepage stays flat).
// Motion and the live demo live in src/scripts/worldbar-page.ts; the screenshots are real
// captures of the app (public/assets/worldbar/), never mock-ups.
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const shots = `${base}assets/worldbar/`;
// The Mac App Store listing. It returns 404 until Apple releases the app, so this change waits for that.
const STORE = 'https://apps.apple.com/app/id6836081075';
const SUPPORT = `${base}worldbar/support/`;
const PRIVACY = `${base}worldbar/privacy/`;

// The demo cities. Times below are the spec example (19 Nov 2026, 14:00 in London), rendered at
// build time so the page reads complete without JavaScript; the script takes over with live times.
const EXAMPLE = new Date('2026-11-19T14:00:00Z');
const demoCities = [
  { id: 'london', name: 'London', code: 'GB', tz: 'Europe/London', on: true },
  { id: 'newyork', name: 'New York', code: 'US', tz: 'America/New_York', on: true },
  { id: 'berlin', name: 'Berlin', code: 'DE', tz: 'Europe/Berlin', on: true },
  { id: 'singapore', name: 'Singapore', code: 'SG', tz: 'Asia/Singapore', on: false },
  { id: 'sydney', name: 'Sydney', code: 'AU', tz: 'Australia/Sydney', on: false },
].map((c) => ({
  ...c,
  time: new Intl.DateTimeFormat('en-GB', { timeZone: c.tz, hour: '2-digit', minute: '2-digit', hour12: false }).format(EXAMPLE),
  date: new Intl.DateTimeFormat('en-GB', { timeZone: c.tz, weekday: 'short', day: 'numeric', month: 'short' }).format(EXAMPLE),
}));

// "London, New York and Berlin": the ticked cities, as the app's planner words them.
const joinNames = (names: string[]) =>
  names.length < 2 ? (names[0] ?? '') : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
const comparing = `Comparing ${joinNames(demoCities.filter((c) => c.on).map((c) => c.name))}`;

const steps = [
  {
    title: 'Add the cities that matter',
    text: 'Search 194 cities by name, country or time zone. It works offline, and your home city gets a "You" badge.',
    shot: 'picker',
    w: 756,
    h: 870,
    focus: 'picker',
    alt: 'The add-city screen listing cities with their current local times',
  },
  {
    title: 'Drag through the day',
    text: 'Slide the time and every city follows, with the right day, the right offset and daylight saving for that date.',
    shot: 'popover',
    w: 758,
    h: 1463,
    focus: 'top',
    alt: 'The clock list, with a checkbox on each city and Singapore and Sydney left unticked, and the time-travel slider showing Thursday 19 November, 14:00 in London',
  },
  {
    title: 'Find the overlap',
    text: 'Tick the cities in the meeting. A 24-hour timeline shows when they are all in working hours. Green means all of them. Drag the block to pick a time.',
    shot: 'popover',
    w: 758,
    h: 1463,
    focus: 'bottom',
    alt: 'The meeting planner comparing London, New York and Berlin, with a green window from 14:00 to 16:00',
  },
  {
    title: 'No overlap? It says so',
    text: 'When nobody shares working hours it tells you, then suggests the next best times and shows who is outside working hours.',
    shot: 'nooverlap',
    w: 758,
    h: 1723,
    focus: 'nooverlap',
    alt: 'The planner reporting no shared working hours, with three alternative times',
  },
];

const bento = [
  { n: '01', title: 'Four ways to sit in the menu bar', text: 'Show a globe, one city and its time, just the time, or two cities.' },
  { n: '02', title: 'Light and dark, properly', text: 'It follows your Mac, or you can pick one.' },
  { n: '03', title: 'Private by design', text: 'No account, no analytics, and the app has no network access. Your cities stay on your Mac.' },
  { n: '04', title: 'Hands the event to your calendar', text: 'The meeting opens in Calendar or Outlook for you to check and save.' },
  {
    n: '05',
    title: "Choose who's in the meeting",
    text: 'Each city has a checkbox. Untick one and it stays on your clock list, dimmed, but the planner leaves it out.',
  },
  {
    n: '06',
    title: 'Pop it out of the menu bar',
    text: 'The pin button turns WorldBar into a floating window that stays on top. It remembers where you left it, even after a relaunch. Right-click the menu bar icon to put it back.',
  },
  { n: '07', title: 'Built for the keyboard', text: 'Arrow keys move the meeting block. The usual shortcuts work.' },
];

const facts = [
  'macOS 15 or later',
  'Menu bar app, no Dock icon',
  'Works offline',
];

const description =
  'WorldBar is a free menu bar app for Mac. Keep up to 8 world clocks one click away and find a meeting time that works across time zones. No tracking.';
const site = 'https://njvan.net/';
const shotUrls = ['popover-dark.png', 'popover-light.png', 'picker-dark.png', 'nooverlap-dark.png'].map(
  (f) => `${site}assets/worldbar/${f}`,
);
// Answers are taken from the support and privacy pages, so the three agree.
const faqs = [
  {
    q: 'Is WorldBar free?',
    a: 'Yes. It is free, with no account to make.',
  },
  {
    q: 'What do I need to run it?',
    a: 'A Mac running macOS 15 or later.',
  },
  {
    q: 'How does it find a meeting time?',
    a: 'You set working hours for each city, and WorldBar shows where they overlap. Green means everyone is inside their working hours. If nobody overlaps, it lists the three least inconvenient times and who pays for each one.',
  },
  {
    q: 'Can I leave a city out of the meeting search?',
    a: 'Yes. Every city has a checkbox. Untick a city and it stays on your clock list, dimmed, but the planner leaves it out. The planner says which cities it is comparing, and "All cities" puts them all back.',
  },
  {
    q: 'Can I keep WorldBar on screen?',
    a: 'Yes. The pin button at the top of the panel pops WorldBar out into a floating window that stays on top of your other windows. It remembers where you put it, and it is back there after you relaunch the app. Right-click the menu bar icon to return it to the menu bar.',
  },
  {
    q: 'Does it read my calendar?',
    a: 'No. It only looks at working hours, never at your meetings, so a green window does not mean anyone is free. "Create calendar event" hands the meeting to Calendar or Outlook, and you review and save it there.',
  },
  {
    q: 'Does it collect any data?',
    a: 'No. There is no sign-in, no analytics, no ads and no tracking. The app runs in the macOS sandbox without network access, so it cannot send anything off your Mac.',
  },
  {
    q: 'Does it work offline?',
    a: 'Yes. The time zone rules and the list of 194 cities are built in, so searching and the calculations need no internet.',
  },
  {
    q: 'How many cities can I add?',
    a: 'Up to 8.',
  },
  {
    q: 'Does it handle daylight saving?',
    a: 'Yes. It uses the official time zone rules for the exact date you pick, so clock changes are right in every city.',
  },
];
const softwareApp = {
  '@type': 'SoftwareApplication',
  name: 'WorldBar',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS 15 or later',
  description,
  url: 'https://njvan.net/worldbar/',
  image: `${site}og/worldbar.jpg`,
  screenshot: shotUrls,
  featureList: [
    'World clocks for up to 8 cities in the menu bar',
    'Drag through the day to see every city at that time',
    'Meeting planner that finds when everyone is in working hours',
    'Tick cities in or out of the meeting search',
    'Pin it into a floating window that stays on top',
    'Hands the event to Calendar or Outlook',
    'Works offline, with no account and no tracking',
  ],
  downloadUrl: STORE,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Nathan VanderByl', url: 'https://njvan.net/' },
};
const faqPage = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const jsonLd = { '@context': 'https://schema.org', '@graph': [softwareApp, faqPage] };
---

<Base
  title="WorldBar: world clocks and meeting planner for Mac"
  description={description}
  image="/og/worldbar.jpg"
  imageAlt="WorldBar: find a time that works for everyone, shown as a stack of the app's panels"
  jsonLd={jsonLd}
>
  <!-- Marks the page as scripted so the pinned story layout is in place before first paint.
       If the page script has not started within 2.5s, fall back to the plain stacked layout. -->
  <script is:inline slot="head">
    document.documentElement.dataset.wbJs = '';
    setTimeout(function () {
      if (!('wbReady' in document.documentElement.dataset)) delete document.documentElement.dataset.wbJs;
    }, 2500);
  </script>

  <!-- ============ Hero: the field, the name, the isometric stack ============ -->
  <section class="wb-hero" aria-labelledby="wb-title" data-wb-hero>
    <div class="wb-hero__field" aria-hidden="true">
      <span class="wb-hero__orb wb-hero__orb--a"></span>
      <span class="wb-hero__orb wb-hero__orb--b"></span>
      <span class="wb-hero__grid"></span>
    </div>

    <div class="shell wb-hero__inner">
      <div class="wb-hero__top t-caption" data-wb-rise>
        <span>WorldBar · Tool</span>
        <span>For Mac</span>
      </div>

      <div class="wb-hero__copy">
        <img class="wb-icon" src={`${shots}icon.png`} width="72" height="72" alt="" data-wb-rise />
        <h1 class="wb-hero__name" id="wb-title" data-wb-letters>WorldBar</h1>
        <p class="wb-hero__line" data-wb-rise>Find a time that works for everyone.</p>
        <p class="wb-hero__more t-body" data-wb-rise>
          A menu bar app for your Mac. Keep up to 8 cities one click away, drag through the day, and see when
          everyone is in working hours.
        </p>
        <div class="wb-hero__links" data-wb-rise>
          <!-- Apple's own badge, unaltered: black on this light field. -->
          <a class="wb-badge" href={STORE} target="_blank" rel="noopener" aria-label="Download WorldBar on the Mac App Store">
            <img src={`${shots}badge-mac-app-store-black.svg`} alt="Download on the Mac App Store" width="156" height="40" />
          </a>
          <a class="btn btn--lg wb-btn wb-btn--solid" href="#try">Try it below ↓</a>
        </div>
        <p class="wb-hero__note t-annotation" data-wb-rise>Free · macOS 15 or later · No account · No tracking</p>
      </div>

      <div class="wb-hero__visual" aria-hidden="true">
        <div class="wb-iso" data-wb-iso>
          <span class="wb-iso__floor" data-wb-floor></span>
          <div class="wb-iso__world" data-wb-world>
            <figure class="wb-slab wb-slab--planner" data-wb-slab="0">
              <img src={`${shots}popover-dark.png`} alt="" width="758" height="1463" fetchpriority="high" />
              <figcaption class="t-annotation">03 · Meeting planner</figcaption>
            </figure>
            <figure class="wb-slab wb-slab--travel" data-wb-slab="1">
              <img src={`${shots}popover-dark.png`} alt="" width="758" height="1463" fetchpriority="high" />
              <figcaption class="t-annotation">02 · Time travel</figcaption>
            </figure>
            <figure class="wb-slab wb-slab--clocks" data-wb-slab="2">
              <img src={`${shots}popover-dark.png`} alt="" width="758" height="1463" fetchpriority="high" />
              <figcaption class="t-annotation">01 · World clocks</figcaption>
            </figure>
          </div>
          <!-- Live local times drifting around the stack. Decoration only: real times, no invented screens. -->
          <span class="wb-chip wb-chip--a" data-wb-chip data-tz="Asia/Tokyo"><i>TYO</i><b>--:--</b></span>
          <span class="wb-chip wb-chip--b" data-wb-chip data-tz="America/Los_Angeles"><i>SFO</i><b>--:--</b></span>
          <span class="wb-chip wb-chip--c" data-wb-chip data-tz="Europe/Paris"><i>PAR</i><b>--:--</b></span>
          <span class="wb-chip wb-chip--d" data-wb-chip data-tz="Australia/Sydney"><i>SYD</i><b>--:--</b></span>
        </div>
      </div>
    </div>

    <div class="shell wb-hero__meta t-annotation">
      <span>Hover or tap the popover to see its layers</span>
      <span aria-hidden="true">Scroll ↓</span>
    </div>
  </section>

  <!-- ============ 01 · Live demo ============ -->
  <section class="wb-section shell" id="try" aria-labelledby="wb-demo-title">
    <p class="wb-eyebrow t-annotation" data-wb-reveal>01 · Try it</p>
    <h2 class="wb-h2" id="wb-demo-title" data-wb-split>Drag through the day to find a time.</h2>
    <p class="wb-lede t-body" data-wb-reveal>
      Every city updates at once. This runs in your browser with today's real offsets, so daylight saving is
      already in the sums. Tick cities in or out to see the overlap move.
    </p>

    <div class="wb-demo" data-wb-demo data-wb-reveal>
      <div class="wb-demo__head">
        <output class="wb-demo__when" data-demo-when>Thu 19 Nov · 14:00 in London</output>
        <button class="btn wb-btn-now" type="button" data-demo-now hidden>Now</button>
      </div>
      <input
        class="wb-range"
        type="range"
        min="0"
        max="1425"
        step="15"
        value="840"
        aria-label="Time of day in London"
        data-demo-range
      />
      <ul class="wb-rows">
        {
          demoCities.map((c) => (
            <li class="wb-row" data-city={c.tz} data-on={c.on ? 'true' : 'false'}>
              <label class="wb-row__check">
                <input type="checkbox" checked={c.on} aria-label={`Include ${c.name} in the meeting`} data-demo-check />
                <span class="wb-row__box" aria-hidden="true"></span>
              </label>
              <div class="wb-row__name">
                <span class="t-annotation muted">{c.code}</span>
                <span>{c.name}</span>
              </div>
              <div class="wb-row__time" data-time>{c.time}</div>
              <div class="wb-row__date t-annotation muted" data-date>{c.date}</div>
              <div class="wb-row__bar" data-bar aria-hidden="true"></div>
            </li>
          ))
        }
      </ul>
      <div class="wb-demo__overlap" data-demo-overlap>
        <p class="wb-demo__comparing">
          <span class="wb-demo__overlap-label t-annotation" data-demo-comparing>{comparing}</span>
          <!-- Puts every city back in, like the app's "All cities". Needs the script, so it starts hidden. -->
          <button class="wb-demo__reset t-annotation" type="button" hidden data-demo-reset>All cities</button>
        </p>
        <div class="wb-row__bar wb-row__bar--all" data-bar-all aria-hidden="true"></div>
      </div>
      <p class="wb-demo__result" data-demo-result aria-live="polite">Best overlap: 14:00 – 16:00 (2 hours)</p>
      <p class="wb-demo__note t-annotation muted">
        Working hours 09:00 – 17:00 local · The demo assumes a weekday · Working hours only, never your calendar
      </p>
    </div>
  </section>

  <!-- ============ 02 · Scroll story with the real screenshots ============ -->
  <section class="wb-story" data-wb-story aria-labelledby="wb-story-title">
    <div class="wb-story__sticky">
      <div class="shell wb-story__grid">
        <div class="wb-story__copy">
          <p class="wb-eyebrow t-annotation">02 · How it works</p>
          <h2 class="wb-h2" id="wb-story-title">Four steps, one click.</h2>
          <ol class="wb-steps">
            {
              steps.map((s, i) => (
                <li class="wb-step" data-wb-step={i}>
                  <span class="wb-step__num t-annotation">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="wb-step__title">{s.title}</h3>
                  <p class="wb-step__text t-body">{s.text}</p>
                </li>
              ))
            }
          </ol>
          <div class="wb-story__rule" aria-hidden="true"><span data-wb-story-bar></span></div>
        </div>

        <div class="wb-stage" aria-hidden="true">
          <span class="wb-stage__glow"></span>
          <div class="wb-stage__frame" data-wb-frame>
            {
              steps.map((s, i) => (
                <div class="wb-shot" data-wb-shot={i} data-focus={s.focus ?? 'all'}>
                  <img class="wb-shot__img wb-theme-dark" src={`${shots}${s.shot}-dark.png`} alt="" width={s.w} height={s.h} loading="lazy" decoding="async" />
                  <img class="wb-shot__img wb-theme-light" src={`${shots}${s.shot}-light.png`} alt="" width={s.w} height={s.h} loading="lazy" decoding="async" />
                </div>
              ))
            }
            <span class="wb-spot" data-wb-spot></span>
          </div>
        </div>
      </div>
    </div>

    <!-- The same steps, with their screenshots, for narrow screens and when scripts are off. -->
    <ol class="wb-story__stack">
      {
        steps.map((s, i) => (
          <li>
            <span class="wb-step__num t-annotation">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="wb-step__title">{s.title}</h3>
            <p class="t-body muted">{s.text}</p>
            <img class="wb-theme-dark" src={`${shots}${s.shot}-dark.png`} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" />
            <img class="wb-theme-light" src={`${shots}${s.shot}-light.png`} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" />
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ============ 03 · Details ============ -->
  <section class="wb-section shell" aria-labelledby="wb-bento-title">
    <p class="wb-eyebrow t-annotation" data-wb-reveal>03 · The details</p>
    <h2 class="wb-h2" id="wb-bento-title" data-wb-split>A menu bar app, in detail.</h2>

    <div class="wb-bento">
      <!-- Menu bar styles -->
      <article class="wb-card wb-card--wide" data-wb-card>
        <span class="wb-card__n t-annotation">{bento[0].n}</span>
        <h3 class="wb-card__title">{bento[0].title}</h3>
        <p class="wb-card__text t-body">{bento[0].text}</p>
        <div class="wb-bars" aria-hidden="true">
          <div class="wb-bar" data-wb-menubar="globe"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/></svg></div>
          <div class="wb-bar" data-wb-menubar="city"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/></svg><span data-bar-city="Europe/London" data-bar-name="London">London --:--</span></div>
          <div class="wb-bar" data-wb-menubar="time"><span data-bar-city="Europe/London" data-bar-name="">--:--</span></div>
          <div class="wb-bar" data-wb-menubar="two"><span data-bar-city="Europe/London" data-bar-name="London">London --:--</span><i>·</i><span data-bar-city="Asia/Tokyo" data-bar-name="Tokyo">Tokyo --:--</span></div>
        </div>
      </article>

      <!-- Light and dark wipe -->
      <article class="wb-card wb-card--tall" data-wb-card>
        <span class="wb-card__n t-annotation">{bento[1].n}</span>
        <h3 class="wb-card__title">{bento[1].title}</h3>
        <p class="wb-card__text t-body">{bento[1].text}</p>
        <div class="wb-wipe" data-wb-wipe aria-hidden="true">
          <img src={`${shots}popover-dark.png`} alt="" width="758" height="1463" loading="lazy" decoding="async" />
          <img class="wb-wipe__top" src={`${shots}popover-light.png`} alt="" width="758" height="1463" loading="lazy" decoding="async" />
          <span class="wb-wipe__handle"></span>
        </div>
      </article>

      <!-- Private -->
      <article class="wb-card" data-wb-card>
        <span class="wb-card__n t-annotation">{bento[2].n}</span>
        <h3 class="wb-card__title">{bento[2].title}</h3>
        <p class="wb-card__text t-body">{bento[2].text}</p>
        <ul class="wb-ticks t-annotation" aria-label="What WorldBar does not do">
          <li><span aria-hidden="true">✕</span> Account</li>
          <li><span aria-hidden="true">✕</span> Analytics</li>
          <li><span aria-hidden="true">✕</span> Network access</li>
        </ul>
      </article>

      <!-- Calendar -->
      <article class="wb-card" data-wb-card>
        <span class="wb-card__n t-annotation">{bento[3].n}</span>
        <h3 class="wb-card__title">{bento[3].title}</h3>
        <p class="wb-card__text t-body">{bento[3].text}</p>
        <div class="wb-chips t-annotation" aria-hidden="true">
          <span>Calendar</span><span>Outlook</span><span>Outlook on the web</span>
        </div>
      </article>

      <!-- Choose the cities: the real checkboxes, ticking and unticking on a loop -->
      <article class="wb-card wb-card--wide" data-wb-card>
        <span class="wb-card__n t-annotation">{bento[4].n}</span>
        <h3 class="wb-card__title">{bento[4].title}</h3>
        <p class="wb-card__text t-body">{bento[4].text}</p>
        <div class="wb-pick" aria-hidden="true">
          <ul class="wb-pick__list">
            <li class="wb-pick__item wb-pick__item--on"><i class="wb-pick__box"></i><span>London</span></li>
            <li class="wb-pick__item wb-pick__item--on"><i class="wb-pick__box"></i><span>New York</span></li>
            <li class="wb-pick__item wb-pick__item--on"><i class="wb-pick__box"></i><span>Berlin</span></li>
            <li class="wb-pick__item wb-pick__item--swing"><i class="wb-pick__box"></i><span>Singapore</span></li>
            <li class="wb-pick__item wb-pick__item--swing wb-pick__item--late"><i class="wb-pick__box"></i><span>Sydney</span></li>
          </ul>
          <p class="wb-pick__line t-annotation"><span>Comparing London, New York and Berlin</span></p>
        </div>
      </article>

      <!-- The floating window: the real capture, lifting and settling -->
      <article class="wb-card" data-wb-card>
        <span class="wb-card__n t-annotation">{bento[5].n}</span>
        <h3 class="wb-card__title">{bento[5].title}</h3>
        <p class="wb-card__text t-body">{bento[5].text}</p>
        <div class="wb-float" aria-hidden="true">
          <div class="wb-float__win">
            <img class="wb-theme-dark" src={`${shots}float-dark.png`} alt="" width="758" height="1510" loading="lazy" decoding="async" />
            <img class="wb-theme-light" src={`${shots}float-light.png`} alt="" width="758" height="1510" loading="lazy" decoding="async" />
          </div>
        </div>
      </article>

      <!-- Keyboard -->
      <article class="wb-card wb-card--wide" data-wb-card>
        <span class="wb-card__n t-annotation">{bento[6].n}</span>
        <h3 class="wb-card__title">{bento[6].title}</h3>
        <p class="wb-card__text t-body">{bento[6].text}</p>
        <div class="wb-keys" aria-hidden="true">
          <span><kbd>←</kbd><kbd>→</kbd> Move the meeting 15 min</span>
          <span><kbd>⌘</kbd><kbd>N</kbd> Back to now</span>
          <span><kbd>⌘</kbd><kbd>,</kbd> Settings</span>
        </div>
      </article>

      <!-- Count -->
      <article class="wb-card wb-card--stat" data-wb-card>
        <span class="wb-stat" data-wb-count="194">194</span>
        <p class="wb-card__text t-body">cities built in, and searching them works offline.</p>
      </article>
    </div>
  </section>

  <!-- ============ Closing ============ -->
  <!-- ============ 04 · Questions (also the FAQPage structured data above) ============ -->
  <section class="wb-section shell" aria-labelledby="wb-faq-title">
