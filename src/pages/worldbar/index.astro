    <p class="wb-faq__more t-annotation" data-wb-reveal>
      More in the <a href={SUPPORT}>support pages</a> · How your data is handled is on the{' '}
      <a href={PRIVACY}>privacy page</a>
    </p>
  </section>

  <section class="wb-end shell" aria-labelledby="wb-end-title">
    <ul class="wb-facts t-annotation" data-wb-facts>
      {facts.map((f) => <li>{f}</li>)}
    </ul>
    <h2 class="wb-end__title" id="wb-end-title" data-wb-split>Find a time that works for everyone.</h2>
    <div class="wb-end__links" data-wb-end-links>
      <!-- Apple's badge: white on the dark page, black on the light one. -->
      <a class="wb-badge" href={STORE} target="_blank" rel="noopener" aria-label="Download WorldBar on the Mac App Store">
        <img class="wb-theme-dark" src={`${shots}badge-mac-app-store-white.svg`} alt="Download on the Mac App Store" width="156" height="40" />
        <img class="wb-theme-light" src={`${shots}badge-mac-app-store-black.svg`} alt="" width="156" height="40" />
      </a>
      <a class="btn btn--lg" href={SUPPORT}>Support</a>
      <a class="btn btn--lg" href={PRIVACY}>Privacy</a>
    </div>
  </section>
</Base>

