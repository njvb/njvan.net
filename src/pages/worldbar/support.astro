---
// WorldBar support: the Support URL for the App Store listing.
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const EMAIL = 'njvanderbyl@gmail.com';

const faqs = [
  {
    q: 'Where is WorldBar? I can\'t see a window.',
    a: 'WorldBar lives in the menu bar, with no Dock icon unless you turn one on. Click the globe (or the city and time) at the top of your screen to open it. Right-click it for Settings and Quit.',
  },
  {
    q: 'How do I change my home city?',
    a: 'Right-click a city in the list and choose Set as Home City, or pick it under Settings, General. The home city gets the "You" badge, and the time slider and the planner use its day.',
  },
  {
    q: 'How do I add, remove or reorder cities?',
    a: 'Use the + button to search 194 bundled cities by name, country or time zone. Drag a row to reorder it, or right-click it to remove it. You can show up to eight cities.',
  },
  {
    q: 'The planner says "No shared working hours on this date." What now?',
    a: 'It means no time that day falls inside everyone\'s working hours. Under it you get the three least inconvenient times, ranked by how many minutes fall outside working hours, with the cities that pay for each one. Untick a city\'s checkbox in the list, or change its hours under Settings, Meetings, to see the overlap return.',
  },
  {
    q: 'How do I leave a city out of the meeting search?',
    a: 'Tick or untick the checkbox on each city in the list. An unticked city stays on the list, dimmed, with its time, but the planner leaves it out. The planner names the cities it is comparing, and "All cities" puts them all back.',
  },
  {
    q: 'How do I keep WorldBar on screen?',
    a: 'Click the pin button at the top of the panel. WorldBar pops out into a floating window that stays on top of your other windows. It remembers where you put it, and if it was open it is back there after you relaunch the app. To return it to the menu bar, click the pin button again, or right-click the menu bar icon and choose Return to Menu Bar.',
  },
  {
    q: 'Does WorldBar have a Dock icon?',
    a: 'Not by default: WorldBar lives in the menu bar and has no Dock icon. To add one, turn on "Show in the Dock" under Settings, General. You get a Dock icon and a Cmd-Tab entry straight away, with no restart, plus a small app menu (About, Settings with Cmd-comma, Hide, and Quit with Cmd-Q) and an Edit menu so copy and paste work. Clicking the Dock icon brings the floating window forward if it is open, and otherwise opens the popover. The menu bar clock always stays, and the setting is remembered after you relaunch.',
  },
  {
    q: 'How do I change working hours?',
    a: 'Open Settings, Meetings, and set each city\'s start and end. An end at or before the start means an overnight shift, and an end equal to the start means all day. Weekends are left out by default; you can include them there.',
  },
  {
    q: 'Does WorldBar read my calendar?',
    a: 'No. It only looks at working hours, never at your meetings, so a green window does not mean anyone is free. "Create calendar event…" hands the meeting to Calendar or Outlook, and you review and save it there. Choose which one under Settings, Meetings.',
  },
  {
    q: 'Can I start it when I log in?',
    a: 'Yes. Turn on Launch at login under Settings, General. If macOS asks, allow it in System Settings, General, Login Items.',
  },
  {
    q: 'A time looks wrong near a clock change.',
    a: 'WorldBar uses the official time zone rules for the exact date you pick, so clock changes should be right. If you find one that isn\'t, email me the cities, the date and the time you expected.',
  },
  {
    q: 'My city is missing.',
    a: 'The app ships a list of about 190 major cities. Email me the city and its time zone name (for example Europe/Madrid) and I\'ll add it.',
  },
  {
    q: 'How do I remove WorldBar and its data?',
    a: 'Quit it from the right-click menu, then drag it to the Bin. Your cities and settings are kept in the app\'s own folder, ~/Library/Containers/com.njvan.WorldBar, so delete that folder too if you want them gone.',
  },
];
---

<Base
  title="Support · WorldBar"
  description="Help for WorldBar, the menu bar app for world clocks and meeting times on Mac: setup, working hours, calendar and Outlook, and how to get in touch."
  image="/og/worldbar.jpg"
  imageAlt="WorldBar: find a time that works for everyone"
>
  <article class="doc shell">
    <p class="doc__crumb t-annotation"><a href={`${base}worldbar/`}>WorldBar</a> · Support</p>
    <h1 class="doc__title">Support</h1>
    <p class="doc__lede t-body">Questions, bugs and ideas are welcome. I read everything.</p>

    <div class="doc__panel">
      <p>
        Email <a href={`mailto:${EMAIL}?subject=WorldBar`}>{EMAIL}</a>. Include your Mac model, your macOS version and
        what you expected to happen, and a screenshot if you can. I usually reply within a couple of days.
      </p>
    </div>

    <h2 class="doc__h2">Questions</h2>
    <dl class="faq">
      {
        faqs.map((f) => (
          <div class="faq__item">
            <dt>{f.q}</dt>
            <dd class="muted">{f.a}</dd>
          </div>
        ))
      }
    </dl>

    <h2 class="doc__h2">Known issues</h2>
    <p class="muted">None yet. Found one? Email me.</p>

    <p class="doc__links t-annotation">
      <a href={`${base}worldbar/`}>WorldBar</a> · <a href={`${base}worldbar/privacy/`}>Privacy</a>
    </p>
  </article>
</Base>

<style>
  :global(html) {
    scroll-snap-type: none !important;
  }

  :global(.site-header) {
    position: static !important;
  }

  .doc {
    padding-block: 56px 112px;
    max-width: calc(820px + 2 * var(--pad));
  }

  .doc__crumb {
    color: var(--color-muted);
    margin-bottom: 18px;
  }

  .doc__crumb a {
    text-decoration: none;
  }

  .doc__crumb a:hover {
    text-decoration: underline;
  }

  .doc__title {
    font-size: clamp(2.6rem, 8vw, 5rem);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 14px;
  }

  .doc__lede {
    color: var(--color-muted);
    margin-bottom: 32px;
  }

  .doc__panel {
    padding: 20px 22px;
    margin-bottom: 48px;
    border: var(--border-hairline) solid var(--color-border);
    border-left: 4px solid var(--color-worldbar);
    border-radius: 14px;
    background:
      radial-gradient(80% 120% at 100% 0%, color-mix(in srgb, var(--color-worldbar) 14%, transparent), transparent 70%),
      var(--color-surface);
  }

  .doc__h2 {
    font-size: 28px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
  }

  .faq {
    margin: 0 0 56px;
  }

  .faq__item {
    padding-block: 18px;
    border-top: var(--border-hairline) solid var(--color-border);
  }

  .faq__item dt {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }

  .faq__item dd {
    margin: 0;
    max-width: 62ch;
  }

  .muted {
    color: var(--color-muted);
  }

  .doc__links {
    margin-top: 48px;
    color: var(--color-muted);
  }
</style>
