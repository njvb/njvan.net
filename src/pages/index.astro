---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import Scene from '../components/Scene.astro';
import TavrenBoard from '../components/scenes/TavrenBoard.astro';
import KoraPanels from '../components/scenes/KoraPanels.astro';
import CotripRoute from '../components/scenes/CotripRoute.astro';
import TowerPhone from '../components/scenes/TowerPhone.astro';
import TowerBackdrop from '../components/scenes/TowerBackdrop.astro';
import WorldbarBackdrop from '../components/scenes/WorldbarBackdrop.astro';
import WorldbarStack from '../components/scenes/WorldbarStack.astro';
import PasteperfectWindow from '../components/scenes/PasteperfectWindow.astro';
import { projects, contact } from '../data/projects';

const visuals = {
  tavren: TavrenBoard,
  kora: KoraPanels,
  cotrip: CotripRoute,
  tower: TowerPhone,
  worldbar: WorldbarStack,
  pasteperfect: PasteperfectWindow,
};

// Tells search engines who the site is about and links the name to LinkedIn.
const siteUrl = 'https://njvan.net/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#nathan`,
      name: 'Nathan VanderByl',
      url: siteUrl,
      ...(contact.linkedin ? { sameAs: [contact.linkedin] } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Nathan VanderByl',
      description: "Games, tools and apps I've built.",
      inLanguage: 'en-GB',
      publisher: { '@id': `${siteUrl}#nathan` },
    },
  ],
};
---

<Base
  title="Nathan VanderByl · Games, tools and apps"
  description="Games, tools and apps I've built: Tavren, Kora, Cotrip, Campaign Tower, WorldBar and PastePerfect."
  image="/og/home.jpg"
  imageAlt="Nathan VanderByl. Games, tools and apps I've built."
  jsonLd={jsonLd}
>
  <Hero />
  <ProjectIndex />
  {
    projects.map((p) => {
      const Visual = visuals[p.id];
      return (
        <Scene project={p} total={projects.length}>
          {p.id === 'tower' && <TowerBackdrop slot="backdrop" />}
          {p.id === 'worldbar' && <WorldbarBackdrop slot="backdrop" />}
          <Visual />
        </Scene>
      );
    })
  }
</Base>
