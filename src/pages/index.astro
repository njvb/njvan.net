---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import Stage from '../components/Stage.astro';
import { contact } from '../data/projects';

// Tells search engines who the site is about and links the name to LinkedIn.
const siteUrl = 'https://njvan.net/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#nathan`,
      name: 'Nathan VanderByl',
      url: siteUrl,
      ...(contact.linkedin ? { sameAs: [contact.linkedin] } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Nathan VanderByl',
      description: "Games, tools and apps I've built.",
      inLanguage: 'en-GB',
      publisher: { '@id': `${siteUrl}#nathan` },
    },
  ],
};
---

<Base
  title="Nathan VanderByl · Games, tools and apps"
  description="Games, tools and apps I've built: Tavren, Kora, Cotrip, Campaign Tower, WorldBar and PastePerfect."
  image="/og/home.jpg"
  imageAlt="Nathan VanderByl. Games, tools and apps I've built."
  jsonLd={jsonLd}
>
  <script is:inline slot="head">
    // Scenes open from the cards as a full-screen stage. Without this (no JavaScript) they stay plain sections.
    document.documentElement.classList.add('has-stage');
  </script>
  <Hero />
  <ProjectIndex />
  <Stage />
</Base>
