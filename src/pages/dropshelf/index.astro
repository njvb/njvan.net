---
// DropShelf's landing page, served at njvan.net/dropshelf/ (with /support/ and /privacy/, for its App Store listing).
// It is Nathan's own design, ported as it is from ~/Projects/Dropshelf/dropshelf-site (markup from its index.html, styles
// scoped to .dsx in src/styles/dropshelf.css, its script and images in public/dropshelf/), inside this site's header
// and footer, like Campaign Tower's page. Only the facts changed: free to download with DropShelf Pro as a one-time
// purchase (no price, it has a launch price), macOS 15 or later, coming soon to the Mac App Store. The library
// screenshot is the regenerated, tooltip-free capture. If the original changes, port the change here by hand.
import Base from '../../layouts/Base.astro';
import '../../styles/dropshelf.css';

const description =
  'DropShelf is a visual workspace for your Mac. Keep the files, folders and links you are working on close, wherever they live, and link, copy or move them, your way.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DropShelf',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS 15 or later',
  description,
  url: 'https://njvan.net/dropshelf/',
  image: 'https://njvan.net/og/dropshelf.jpg',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
  author: { '@type': 'Person', name: 'Nathan VanderByl', url: 'https://njvan.net/' },
};
---

<Base
  title="DropShelf: Your files. All in one place."
  description={description}
  image="/og/dropshelf.jpg"
  imageAlt="DropShelf: your files, all in one place."
  jsonLd={jsonLd}
>
  <!-- No intro on this page: show the header settled at once. -->
  <script is:inline slot="head">
    (function () {
      clearTimeout(window.__motionBootTimer);
      document.documentElement.dataset.motionBoot = 'settled';
      document.addEventListener('DOMContentLoaded', function () { document.body.dataset.phase = 'settled'; });
    })();
  </script>
  <script is:inline slot="head" src="/dropshelf/script.js" defer></script>

  <div class="dsx" id="dropshelf-page">
    <Fragment set:html={'<svg class="svg-defs" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>\n  <symbol id="layers" viewBox="0 0 24 24"><path d="m12 3 10 5-10 5L2 8l10-5ZM2 12l10 5 10-5M2 16l10 5 10-5"/></symbol>\n  <symbol id="folder" viewBox="0 0 24 24"><path d="M3 6a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></symbol>\n  <symbol id="bolt" viewBox="0 0 24 24"><path d="m14 2-9 12h6l-1 8 9-13h-6Z"/></symbol>\n  <symbol id="monitor" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M12 17v4m-5 0h10"/></symbol>\n  <symbol id="link" viewBox="0 0 24 24"><path d="m10 13 4-4m-6 7-1 1a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m2 1 1-1a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0" transform="translate(1 0)"/></symbol>\n  <symbol id="copy" viewBox="0 0 24 24"><rect x="8" y="8" width="13" height="13" rx="2"/><path d="M16 8V3H3v13h5"/></symbol>\n  <symbol id="arrow" viewBox="0 0 24 24"><path d="M3 12h18m-7-7 7 7-7 7"/></symbol>\n  <symbol id="play" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m10 8 6 4-6 4Z"/></symbol>\n</defs></svg>'} />

  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-waves" aria-hidden="true"></div>
    <div class="container hero-content">
      <div class="hero-brand"><img src="assets/app-icon.png" alt="" width="88" height="88"><span>DropShelf</span></div>
      <h1 id="hero-title">Your files. All in one place.</h1>
      <p class="hero-intro">A beautiful, visual workspace for your Mac. Keep your important files<br class="desktop-break"> close, wherever they live  -  link, copy or move them, your way.</p>
      <div class="hero-actions"><a class="button" href="#download" data-download>Get DropShelf <svg aria-hidden="true"><use href="#arrow"/></svg></a><button class="button button-secondary" data-tour hidden><svg aria-hidden="true"><use href="#play"/></svg>Take a quick tour</button></div>
      <p class="release-note">Free to download · DropShelf Pro, a one-time purchase · macOS 15 or later <span class="note-divider">|</span> Coming soon to the Mac App Store</p>
      <div class="product-showcase" id="screenshots">
        <figure class="library-preview"><a href="assets/library.png" data-image="library"><img src="assets/library.png" width="2000" height="1360" alt="DropShelf library with shelves in the sidebar and a visual grid of images, folders and documents."></a><figcaption>Full library <span>Room for everything you’re working on.</span></figcaption></figure>
        <div class="companion-previews">
          <figure class="shelf-preview"><a href="assets/floating-shelf.png" data-image="shelf"><img src="assets/floating-shelf.png" width="920" height="296" alt="The compact floating shelf, with files in a horizontal row and a shelf selector."></a><figcaption>Floating shelf <span>A little space. A lot closer.</span></figcaption></figure>
          <figure class="menu-preview">
            <div class="mac-bar" aria-hidden="true"><span>⌁</span><svg aria-hidden="true"><use href="#layers"/></svg><span>◉</span><span>⌕</span><span>Mon 10:24</span></div>
            <div class="menu-mock" role="img" aria-label="Illustrated DropShelf menu bar: Quick Shelf, My Shelf, Work, Personal, Show Floating Shelf and Open Library.">
              <div class="menu-app"><img src="assets/app-icon.png" width="17" height="17" alt="">DropShelf</div>
              <div><svg aria-hidden="true"><use href="#bolt"/></svg>Quick Shelf <span>4</span></div>
              <div class="selected"><svg aria-hidden="true"><use href="#layers"/></svg>My Shelf <span>13</span></div>
              <div><svg aria-hidden="true"><use href="#folder"/></svg>Work <span>3</span></div>
              <div><svg aria-hidden="true"><use href="#folder"/></svg>Personal <span>5</span></div>
              <hr><div>Show Floating Shelf</div><div>Open Library…</div><hr><div>Settings…</div>
            </div>
            <figcaption>Always in your menu bar</figcaption>
          </figure>
        </div>
      </div>
      <p class="visual-caption">App screenshots with sample files. Menu-bar illustration. <button class="text-button" data-gallery hidden>Explore the screenshots <span aria-hidden="true">↗</span></button></p>
    </div>
  </section>
  <section class="features container" id="features" aria-label="DropShelf features">
    <article><div class="feature-icon"><svg aria-hidden="true"><use href="#layers"/></svg></div><h2>Bring your files together</h2><p>Keep files, folders, links and<br class="desktop-break"> more in visual collections.</p></article>
    <article><div class="feature-icon"><svg aria-hidden="true"><use href="#folder"/></svg></div><h2>Multiple shelves</h2><p>Organise by project, client<br class="desktop-break"> or however you work.</p></article>
    <article><div class="feature-icon"><svg aria-hidden="true"><use href="#bolt"/></svg></div><h2>Quick Shelf</h2><p>A handy, flexible space<br class="desktop-break"> for files while you work.</p></article>
    <article><div class="feature-icon"><svg aria-hidden="true"><use href="#monitor"/></svg></div><h2>Works where you work</h2><p>Drag files in and out, open<br class="desktop-break"> them, or show them in Finder.</p></article>
  </section>
  <section class="how-section container" id="how-it-works" aria-labelledby="how-title">
    <div class="transfer-art" aria-hidden="true"><div class="art-orb"></div><div class="mini-tray"><span class="file-folder"></span><img src="assets/landscape.svg" alt="" width="70" height="54"><span class="file-paper">PDF</span></div><div class="cursor-mark">↖<span id="operation-badge">↗</span></div><span class="art-label" id="art-label">Keep the original right where it is.</span></div>
    <div class="how-content"><h2 id="how-title">Link, Copy or Move  -  your choice.</h2><p>Add files to DropShelf the way that works for you.</p>
      <div class="mode-options" aria-label="File handling demo">
        <button class="mode-card active" type="button" data-mode="link" aria-pressed="true"><span class="mode-heading"><svg aria-hidden="true"><use href="#link"/></svg><strong>Link to Original</strong></span><span class="default-badge">Default</span><span class="mode-summary">Keep a reference to the file in its current location.</span></button>
        <button class="mode-card" type="button" data-mode="copy" aria-pressed="false"><span class="mode-heading"><svg aria-hidden="true"><use href="#copy"/></svg><strong>Copy to DropShelf</strong></span><span class="mode-summary">Create a copy in DropShelf’s managed storage.</span></button>
        <button class="mode-card" type="button" data-mode="move" aria-pressed="false"><span class="mode-heading"><svg aria-hidden="true"><use href="#arrow"/></svg><strong>Move to DropShelf</strong></span><span class="mode-summary">Move the file into DropShelf and keep it organised there.</span></button>
      </div>
      <p class="demo-explanation" id="mode-description" aria-live="polite">Link keeps your original in place. This is a visual demo; no files are accessed.</p>
    </div>
  </section>
  <section class="download-section container" id="download" aria-labelledby="download-title">
    <div class="download-panel"><img src="assets/app-icon.png" width="100" height="100" alt=""><div class="download-copy"><h2 id="download-title">Ready to simplify<br>your workflow?</h2><p>Your files, a little closer. Your Mac, a little calmer.</p></div><div class="download-action"><a class="button" href="#release-details" data-download>Get DropShelf <svg aria-hidden="true"><use href="#arrow"/></svg></a><p>Free to download · macOS 15 or later</p></div></div>
    <p class="release-details" id="release-details">Coming soon to the Mac App Store. DropShelf is free to download; DropShelf Pro, a one-time in-app purchase, adds multiple shelves and private shelves.</p>
  </section>
  <section class="support container" id="support" aria-labelledby="support-title"><h2 id="support-title">A few useful details.</h2><div class="faq-grid">
    <details><summary>What happens to my original files?</summary><p>Link leaves them where they are. Copy creates a separate managed copy. Move transfers the file into DropShelf; the current app sends the original to the Trash only after verifying the transfer.</p></details>
    <details><summary>Can I try the page’s demos?</summary><p>Yes. Choose Link, Copy or Move above, or take the quick tour. These are website demonstrations and never read, upload, copy or move your files.</p></details>
    <details><summary>Where can I download DropShelf?</summary><p>DropShelf is coming soon to the Mac App Store. It is free to download, with DropShelf Pro as a one-time in-app purchase, and needs macOS 15 or later.</p></details>
  </div><p class="support-more">More help: <a href="/dropshelf/support/">Support</a> · <a href="/dropshelf/privacy/">Privacy policy</a></p></section>

    <Fragment set:html={'<dialog id="preview-dialog" aria-labelledby="dialog-title"><button class="dialog-close" aria-label="Close dialog" type="button">×</button><div id="dialog-content"></div></dialog>'} />
  </div>
</Base>

<style is:global>
  /* The site's panel snapping and over-the-hero header are for the home page; this page scrolls freely. */
  html:has(#dropshelf-page) {
    scroll-snap-type: none !important;
  }
  html:has(#dropshelf-page) .site-header {
    position: static !important;
  }
  .dsx .support-more {
    margin-top: 28px;
    color: var(--muted);
  }
  .dsx .support-more a {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
