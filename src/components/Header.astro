---
// On the homepage the links scroll within the page; elsewhere they lead back to it.
// The footer (and its #contact) is on every page.
const base = import.meta.env.BASE_URL;
const onHome = Astro.url.pathname.replace(/\/$/, '') === base.replace(/\/$/, '');
const links = [
  { href: onHome ? '#projects' : `${base}#projects`, label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="wordmark" href={onHome ? '#top' : base} aria-label={onHome ? 'njvan, back to top' : 'njvan, home'} data-intro data-wordmark>
      <span class="wordmark__text" data-wordmark-text>njvan</span>
      <span class="wordmark__rule" data-wordmark-rule aria-hidden="true"></span>
    </a>

    <nav class="nav nav--wide" aria-label="Main">
      {links.map((l) => <a class="t-annotation" href={l.href} data-intro data-rise>{l.label}</a>)}
    </nav>

    <!-- A details element so the menu opens and closes without JavaScript. -->
    <details class="menu" data-intro data-rise>
      <summary class="menu__button" aria-label="Menu">
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
          <path d="M0 1h18M0 11h18" stroke="currentColor" stroke-width="2"></path>
        </svg>
      </summary>
      <nav class="menu__panel" aria-label="Main">
        {links.map((l) => <a class="t-caption" href={l.href}>{l.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu after following one of its links.
  document.querySelectorAll<HTMLDetailsElement>('.menu').forEach((menu) => {
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('.menu__panel a')) menu.open = false;
    });
  });
</script>

<style>
  .site-header {
    padding-top: var(--gutter);
  }

  @media (min-width: 640px) {
    .site-header {
      padding-top: var(--gutter-lg);
    }
  }

  .site-header__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .wordmark {
    position: relative;
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    text-decoration: none;
    padding-bottom: 4px;
    transition: color var(--duration-micro) var(--ease-entrance);
  }

  /* Stable typography for the letter spring-in (see the Animaxxing text-stability notes). */
  .wordmark__text {
    display: inline-block;
    font-kerning: none;
    text-rendering: optimizeSpeed;
  }

  /* The underline, drawn left to right in the intro. */
  .wordmark__rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--border-hairline);
    background: currentColor;
    transform-origin: left center;
  }

  .wordmark:hover {
    color: var(--color-foreground);
  }

  .nav a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-micro) var(--ease-entrance);
  }

  .nav a:hover {
    color: var(--color-foreground);
  }

  .nav--wide {
    display: none;
    gap: 32px;
  }

  .menu {
    position: relative;
  }

  .menu__button {
    list-style: none;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    border: var(--border-strong) solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-foreground);
  }

  .menu__button::-webkit-details-marker {
    display: none;
  }

  .menu[open] .menu__button {
    border-color: var(--color-foreground);
  }

  .menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    z-index: 10;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: var(--border-hairline) solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-2) 0;
  }

  .menu__panel a {
    padding: 14px var(--space-4);
    text-decoration: none;
    color: var(--color-foreground);
  }

  .menu__panel a:hover {
    background: var(--color-surface-hover);
  }

  @media (min-width: 768px) {
    .wordmark {
      font-size: 18px;
      padding-bottom: 6px;
    }

    .nav--wide {
      display: flex;
    }

    .menu {
      display: none;
    }
  }
</style>
