---
// The tower in its settled state: every floor built, the lift parked at the top.
// Colours are Campaign Tower's own pixel palette, scoped to this drawing.
// src/scripts/tower-moment.ts plays the signature moment: the tower builds
// itself floor by floor in pixel steps while the lift rides up the shaft.
const FLOORS = 12;
const CELLS = 6;
const palette = ['#82c9f2', '#f4f1ea', '#f2c94c', '#82c9f2', '#c89b6a', '#f4f1ea'];
// Top floor first, so the markup reads top to bottom like the drawing.
const floors = Array.from({ length: FLOORS }, (_, k) => {
  const level = FLOORS - 1 - k;
  return Array.from({ length: CELLS }, (_, i) => palette[(i + level) % palette.length]);
});
---

<div class="tower" style={`--floors:${FLOORS}`} data-tower>
  <div class="tower__shaft">
    <div class="tower__lift" data-tower-lift></div>
  </div>
  <div class="tower__body">
    {
      floors.map((cells) => (
        <div class="tower__floor" data-tower-floor>
          {cells.map((c) => (
            <span style={`background:${c}`} data-tower-cell />
          ))}
        </div>
      ))
    }
    <div class="tower__base"></div>
  </div>
</div>

<script>
  import { mountTower } from '../../scripts/tower-moment';
  document.querySelectorAll<HTMLElement>('[data-tower]').forEach((root) => {
    try {
      mountTower(root);
    } catch (error) {
      console.error('[tower] moment failed, keeping the built tower', error);
    }
  });
</script>

<style>
  .tower {
    /* One drawing unit: 1px at full size, scaled down to fit narrow columns and short viewports. */
    --u: min(1px, calc(100cqi / 440), calc(58svh / (var(--floors) * 44 + 44)));
    --floor-h: calc(44 * var(--u));
    display: flex;
    align-items: flex-end;
    justify-content: center;
    image-rendering: pixelated;
  }

  .tower__shaft {
    position: relative;
    width: calc(32 * var(--u));
    height: calc(var(--floors) * var(--floor-h) + 44 * var(--u));
    background: #1b1b24;
  }

  /* Parked at the top floor. */
  .tower__lift {
    position: absolute;
    left: calc(4 * var(--u));
    bottom: calc((var(--floors) - 1) * var(--floor-h) + 30 * var(--u));
    width: calc(24 * var(--u));
    height: calc(32 * var(--u));
    background: #f2c94c;
  }

  .tower__body {
    width: calc(384 * var(--u));
    display: flex;
    flex-direction: column;
  }

  .tower__floor {
    height: var(--floor-h);
    padding: calc(8 * var(--u)) calc(12 * var(--u));
    display: flex;
    justify-content: space-between;
    background: #2a2733;
  }

  .tower__floor span {
    width: calc(52 * var(--u));
    height: calc(28 * var(--u));
  }

  .tower__base {
    height: calc(24 * var(--u));
    background: #1b1b24;
  }
</style>
