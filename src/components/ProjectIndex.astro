---
// The project cards: the page's way in. Each opens its project in the stage (see Stage.astro and
// src/scripts/stage.ts); without JavaScript the link goes to the same project further down the page.
// The cards keep the ledger's hooks (data-ledger-*), so src/scripts/ledger.ts plays their entrance
// (hairlines draw, labels decode, names rise, one accent at a time sweeps) and waves the names on hover.
import { projects } from '../data/projects';
const loop = (id: string) => `${import.meta.env.BASE_URL}assets/loops/${id}.webp`;
const thumb = (id: string) => `${import.meta.env.BASE_URL}assets/thumbs/${id}.webp`;
// Each card shows the project's real hero piece, cut out (captured from its own scene), at its own shape.
const sizes: Record<string, [number, number]> = {
  tavren: [900, 590],
  kora: [900, 592],
  cotrip: [335, 700],
  tower: [900, 847],
  worldbar: [363, 700],
  pasteperfect: [900, 692],
};
---

<section class="index" id="projects" aria-labelledby="index-title">
  <div class="shell">
    <div class="index__head" data-scroll-reveal>
      <h2 class="t-caption" id="index-title" aria-label="Projects" data-ledger-scramble>Projects</h2>
      <span class="index__hint t-annotation muted" data-ledger-scramble>Choose one to open it</span>
      <span class="index__rule" aria-hidden="true" data-ledger-rule></span>
    </div>

    <ol class="ledger cards" role="list">
      {
        projects.map((p) => (
          <li data-scroll-reveal>
            <a
              class="ledger-row card"
              href={`#${p.id}`}
              data-project={p.id}
              data-open-project={p.id}
              data-loop={loop(p.id)}
              aria-label={`${p.number}, ${p.kind}: ${p.name}. ${p.indexLine}`}
            >
              <span class="ledger-row__meta t-annotation">
                <span class="ledger-row__num" data-ledger-scramble>{`${p.number} · ${p.kind}`}</span>
                <span class="ledger-row__stack" data-ledger-scramble>{p.indexStack}</span>
              </span>
              <span class="ledger-row__name card__name" data-ledger-name>{p.name}</span>
              <span class="ledger-row__line" data-ledger-line>{p.indexLine}</span>
              <span class="card__thumb" aria-hidden="true">
                <span class="card__tilt" data-card-tilt>
                  <img
                    src={thumb(p.id)}
                    alt=""
                    width={sizes[p.id]?.[0]}
                    height={sizes[p.id]?.[1]}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card__loop" data-card-loop></span>
                </span>
              </span>
              <span class="card__open t-annotation" aria-hidden="true">
                <span>Open</span>
                <span class="card__arrow">&#8599;</span>
              </span>
              <span class="ledger-row__rule" aria-hidden="true" data-ledger-rule></span>
              <span class="ledger-row__accent" aria-hidden="true" data-ledger-accent></span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .index {
    padding-block: 56px 96px;
    container-type: inline-size;
  }

  .index__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    position: relative;
    padding-bottom: var(--space-4);
    margin-bottom: 28px;
  }

  .index__hint {
    display: none;
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .index__hint {
      display: inline;
    }
  }

  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .card {
    --accent: var(--color-foreground);
    --card-on: var(--color-canvas);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    min-height: 400px;
    padding: 20px;
    border: var(--border-hairline) solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    color: var(--color-foreground);
    text-decoration: none;
    overflow: hidden;
    transition:
      background-color 0.35s var(--ease-entrance),
      color 0.35s var(--ease-entrance),
      border-color 0.35s var(--ease-entrance),
      transform 0.45s var(--ease-entrance);
  }

  .card[data-project='tavren'] { --accent: var(--color-tavren); --card-on: var(--color-on-tavren); }
  .card[data-project='kora'] { --accent: var(--color-kora); --card-on: var(--color-on-kora); }
  .card[data-project='cotrip'] { --accent: var(--color-cotrip); --card-on: var(--color-on-cotrip); }
  .card[data-project='tower'] { --accent: var(--color-tower); --card-on: var(--color-on-tower); }
  .card[data-project='worldbar'] { --accent: var(--color-worldbar); --card-on: var(--color-on-worldbar); }
  .card[data-project='pasteperfect'] { --accent: var(--color-pasteperfect); --card-on: var(--color-on-pasteperfect); }

  /* Hairlines are elements, not borders, so the entrance can draw them. The card has its own border, so these hide. */
  .index__rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--border-hairline);
    background: var(--color-border);
    transform-origin: left center;
  }

  .card .ledger-row__rule {
    display: none;
  }

  /* The accent rule: runs along the card's foot in the entrance, and stays on hover or focus. */
  .ledger-row__accent {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--border-strong);
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .ledger-row__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--type-caption-size);
    font-weight: var(--type-caption-weight);
    transition: color 0.3s var(--ease-entrance);
  }

  /* Stable typography for the hover wave: kerning would snap on split and revert. */
  .card__name {
    margin-top: 18px;
    font-size: clamp(2.2rem, 4.2cqi, 3.2rem);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.045em;
    font-kerning: none;
    text-rendering: optimizeSpeed;
  }

  .ledger-row__line {
    font-size: 15px;
    line-height: 22px;
    color: var(--color-muted);
    max-width: 34ch;
    transition: color 0.3s var(--ease-entrance);
  }

  /* The project's real hero piece, cut out. Grey until the card floods; on hover a short loop of its own moment plays
     over it (src/scripts/stage.ts), and the whole thing leans toward the pointer. */
  .card__thumb {
    flex: 1;
    min-height: 240px;
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    perspective: 900px;
  }

  .card__tilt {
    position: relative;
    display: grid;
    place-items: end center;
    width: 100%;
    height: 100%;
    transform-origin: 50% 80%;
    will-change: transform;
  }

  .card__tilt > img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 250px;
    filter: grayscale(1) brightness(0.92);
    transition:
      filter 0.4s var(--ease-entrance),
      opacity 0.2s linear;
  }

  .card__loop {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: end center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s linear;
  }

  .card__loop :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 250px;
  }

  .card.is-looping .card__loop {
    opacity: 1;
  }

  .card.is-looping .card__tilt > img {
    opacity: 0;
  }

  .card__open {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-2);
    color: var(--color-muted);
    transition: color 0.3s var(--ease-entrance);
  }

  .card__arrow {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: var(--border-hairline) solid currentColor;
    border-radius: 50%;
    transition: transform 0.4s var(--ease-entrance);
  }

  /* Room for the name's letters to rise from behind their masks without clipping descenders. */
  .card__name :global(.ledger-char-mask) {
    padding-block: 0.1em;
    margin-block: -0.1em;
  }

  /* Hover or focus: the card floods with its accent (a field, so light theme is fine too). */
  .card:focus-visible {
    outline: var(--border-strong) solid var(--color-foreground);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .card:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--card-on);
      transform: translateY(-4px);
    }
    .card:hover .ledger-row__meta,
    .card:hover .ledger-row__line,
    .card:hover .card__open {
      color: var(--card-on);
    }
    .card:hover .card__tilt > img {
      filter: none;
    }
    .card:hover .card__arrow {
      transform: rotate(-45deg);
    }
  }

  .card:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--card-on);
  }

  .card:focus-visible .ledger-row__meta,
  .card:focus-visible .ledger-row__line,
  .card:focus-visible .card__open {
    color: var(--card-on);
  }

  .card:focus-visible .card__tilt > img {
    filter: none;
  }
</style>
